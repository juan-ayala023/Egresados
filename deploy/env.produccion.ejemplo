# =============================================================================
# .env de PRODUCCION del backend de Homecoming 80 Años.
#
# Va en el servidor, en back-homeparty-main/.env. Este archivo es la plantilla:
# lo que esta entre <> se rellena ALLA, nunca aqui (este archivo se sube al
# repositorio; el .env de verdad no).
#
# Solo estan las variables que cambian respecto al .env.example o que son
# secretas. Todo lo demas toma el valor por defecto documentado en
# back-homeparty-main/.env.example, que es el mismo que se probo.
# =============================================================================

NODE_ENV=production
PORT=4000

# Cuantos proxies hay delante de Node. En el servidor del colegio hay dos
# capas (el borde HTTPS y nginx). Si el borde manda X-Forwarded-For, va 2; si
# no, 1. SE VERIFICA EN EL LOG despues de arrancar (ver DESPLIEGUE.md, paso 4):
# si dos celulares distintos salen con la misma ip=, esta corto y hay que
# subirlo -- o todos los compradores comparten el mismo limite de compras.
TRUST_PROXY=1

# El dominio oficial. El sitio y la API viven en el mismo dominio: nginx manda
# /api/ al backend y el resto al front. Sin CORS entre ellos.
PUBLIC_URL=https://homecomingtcs.columbus.edu.co
CORS_ORIGINS=https://homecomingtcs.columbus.edu.co

DB_PATH=./datos/homecoming.db

# --- Evento ------------------------------------------------------------------
EVENTO_NOMBRE=Homecoming 80 Años
EVENTO_FECHA=2026-11-14T19:00:00-05:00
EVENTO_LUGAR=The Columbus School
EVENTO_DIRECCION=Alto de las Palmas, Medellin
EVENTO_AFORO=500
# LA FECHA REAL DE APERTURA. En local iba en 2020 para poder probar.
VENTA_APERTURA=2026-09-15T00:00:00-05:00
EVENTO_CIERRE_VENTA=2026-11-14T12:00:00-05:00
VENTA_HABILITADA=true

# --- Boleta ------------------------------------------------------------------
BOLETA_ID=homecoming-80
BOLETA_NOMBRE=Boleta Homecoming 80 Años
BOLETA_PRECIO_COP=80000
BOLETA_TARIFA_COP=7000
MAX_POR_COMPRA=4
LIMITE_POR_CEDULA_ACUMULADO=true
MOSTRAR_CUPOS_RESTANTES=false
DATOS_ASISTENTE=acta
EXIGIR_DIRECCION_FACTURACION=true
RESERVA_MINUTOS=45
VALIDAR_EGRESADO=advertir
POLITICA_DATOS_URL=/documentos/PL-RC-01-politica-tratamiento-de-datos.pdf
TERMINOS_URL=

# --- Wompi: PRODUCCION -------------------------------------------------------
# Las CUATRO de "Desarrolladores -> Llaves de produccion". Tienen que empezar
# por pub_prod_, prv_prod_, prod_integrity_, prod_events_. Si alguna dice
# "test", es del sandbox y NO va aqui.
WOMPI_PUBLIC_KEY=<pub_prod_...>
WOMPI_PRIVATE_KEY=<prv_prod_...>
WOMPI_INTEGRITY_SECRET=<prod_integrity_...>
WOMPI_EVENTS_SECRET=<prod_events_...>
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_REDIRECT_URL=https://homecomingtcs.columbus.edu.co/pago/resultado
WOMPI_SIMULACION=false

# --- Secretos propios: SE GENERAN EN EL SERVIDOR ------------------------------
# QR_SECRET firma cada boleta. NUEVO para produccion (si se reutiliza el de
# pruebas, los QR de prueba valdrian en la puerta) y, una vez puesto, NO SE
# CAMBIA NUNCA: cambiarlo invalida todas las boletas ya emitidas.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_SECRET=<generar>
# La clave del panel /admin. Distinta a la de pruebas.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=<generar>

# --- Correo ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=HomecomingTCS@columbus.edu.co
# La clave de aplicacion de Google (16 letras), no la contraseña de la cuenta.
SMTP_PASS=<clave de aplicacion>
MAIL_FROM=Homecoming 80 Años <HomecomingTCS@columbus.edu.co>
SOPORTE_CORREO=HomecomingTCS@columbus.edu.co

# --- SIESA -------------------------------------------------------------------
# Este servidor esta dentro de la red del colegio: le responden los dos.
MSSQL_HOST=10.90.11.15
MSSQL_PORT=1433
MSSQL_DB=ecampus
MSSQL_USER=<usuario>
MSSQL_PASSWORD=<clave>
SIESA_SERVICE_ID=465
SIESA_WSDL_URL=http://10.90.11.140:8082/SERVICIOS/Pangea_Integrador.svc?wsdl
SIESA_F_CIA=1
SIESA_ID_SUCURSAL=001
# EN ENSAYO. Ese WSDL es produccion y no hay ambiente de pruebas. Se pasa a
# false solo despues de mandar UNA factura a mano con Don Luis mirando el ERP:
#   npm run facturar -- HC80-XXXXXX --enviar
SIESA_ENSAYO=true
SIESA_TERCERO_GENERICO=
