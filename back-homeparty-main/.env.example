# =============================================================================
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env      (en PowerShell: copy .env.example .env)
#
# Lo marcado con BLOQUEANTE lo tiene que definir el colegio antes de abrir la
# venta. El servidor arranca sin eso solo mientras WOMPI_SIMULACION=true.
# =============================================================================

NODE_ENV=development
PORT=4000

# URL publica de ESTE backend. Se usa para armar los enlaces del QR y del PDF
# que van dentro del correo: en produccion tiene que ser la real y https.
PUBLIC_URL=http://localhost:4000

# Origenes que pueden llamar a la API, separados por coma.
# En produccion va el subdominio oficial, que el colegio asigno el 13 de
# septiembre de 2026: https://homecomingtcs.columbus.edu.co
CORS_ORIGINS=http://localhost:3000,https://homecomingtcs.columbus.edu.co

# Archivo de la base de datos SQLite.
DB_PATH=./datos/homecoming.db

# -----------------------------------------------------------------------------
# Evento
# -----------------------------------------------------------------------------
EVENTO_NOMBRE=Homecoming 80 Años
EVENTO_FECHA=2026-11-14T19:00:00-05:00
EVENTO_LUGAR=The Columbus School
EVENTO_DIRECCION=Alto de las Palmas, Medellin

# Aforo CERRADO en 500 (decision del comite). La contradiccion de la tabla del
# colegio, que decia 600 en una fila, quedo resuelta.
#
# Sigue parametrizado a proposito: si algun dia cambia, es una linea, no un
# despliegue. Pero no lo subas sin que el comite lo diga: el Sold Out automatico
# depende de este numero y no hay como "des-vender" una boleta.
EVENTO_AFORO=500

# La venta abre sola en esta fecha. Antes, GET /api/evento devuelve
# estadoVenta "proxima" y POST /api/ordenes responde 423.
#
# OJO EN DESARROLLO: con la fecha real la venta esta cerrada hoy y no puedes
# probar el checkout. Pon una fecha pasada en tu .env local, por ejemplo
# 2020-01-01T00:00:00-05:00
VENTA_APERTURA=2026-09-15T00:00:00-05:00

# CONFIRMADO POR EL COLEGIO el 9 de septiembre de 2026: la venta cierra cuando
# se agoten las 500 boletas, no en una fecha. Eso ya pasa solo: al vender la
# ultima, el sitio se pone en Sold Out sin que nadie haga nada.
#
# Esta fecha es solo la RED DE SEGURIDAD por si no se llena el aforo. Antes
# estaba el 7 de noviembre (venia del FAQ, sin confirmar) y habria cerrado la
# venta una semana antes con boletas todavia disponibles.
#
# Queda al MEDIODIA del dia del evento, no a la hora de la fiesta, y es a
# proposito: la lista de codigos para el lector de la puerta se descarga antes
# de arrancar, y alguien que compre a las 6 de la tarde no alcanzaria a estar
# en ella. Siete horas dan margen para generarla con todo el mundo adentro.
EVENTO_CIERRE_VENTA=2026-11-14T12:00:00-05:00

# Interruptor manual para cerrar la venta antes de tiempo.
VENTA_HABILITADA=true

# -----------------------------------------------------------------------------
# Boleta (montos en PESOS; el codigo los convierte a centavos)
# -----------------------------------------------------------------------------
BOLETA_ID=homecoming-80
BOLETA_NOMBRE=Boleta Homecoming 80 Años
BOLETA_PRECIO_COP=80000

# Tarifa de servicio que paga el comprador: 80.000 + 7.000 = 87.000. Tiene que
# coincidir con tarifaServicio en el data.ts del front, o la tarjeta muestra un
# precio y el checkout otro. En 0, el front deja de mostrar el desglose.
BOLETA_TARIFA_COP=7000

# Maximo por transaccion.
MAX_POR_COMPRA=4

# El acta lo confirma: cuando compren las boletas la cedula del comprador queda
# bloqueada para no comprar mas. El limite de 4 es ACUMULADO por cedula.
LIMITE_POR_CEDULA_ACUMULADO=true

# La reunion pidio NO mostrar cupos restantes (estrategia de escasez).
# En false, la API devuelve solo un booleano "disponible".
MOSTRAR_CUPOS_RESTANTES=false

# -----------------------------------------------------------------------------
# Datos que se piden en el checkout
# -----------------------------------------------------------------------------
# Cuantos datos se piden por acompanante:
#   minimo   = nombre + promocion
#   acta     = nombre + tipo y numero de documento + si es egresado
#              (lo que pidio el colegio en la tabla de requerimientos)
#   completo = ademas correo y celular (lo que pide el front hoy)
DATOS_ASISTENTE=acta

# Facturacion DIAN: direccion y ciudad del comprador.
# El front SI las pide y las manda (Checkout.tsx, paso de datos de facturacion).
# Verificado el 5 de septiembre de 2026 contra validarOrden(). Dejalo en true:
# apagarlo emitiria facturas sin direccion, que la DIAN rechaza.
EXIGIR_DIRECCION_FACTURACION=true

# El acta aprobo NIT/CC como campo de facturacion. El tipo de documento siempre
# se guarda (por defecto CC); esto solo obliga al front a mandarlo. Prendelo el
# dia que el checkout tenga el selector.
EXIGIR_TIPO_DOCUMENTO=false

# Minutos que se guarda el cupo mientras el usuario esta dentro de la pasarela.
# PSE se demora con frecuencia mas de 20 minutos.
RESERVA_MINUTOS=45

# -----------------------------------------------------------------------------
# Egresados
# -----------------------------------------------------------------------------
# El acta exige que quien COMPRA sea egresado, con doble check contra la base
# que entrega mercadeo. Los acompanantes pueden no serlo.
#
#   apagado  -> no se revisa nada
#   advertir -> se revisa, se marca en la orden, pero la compra pasa
#   exigir   -> quien no aparezca en la base recibe 409 NO_ES_EGRESADO
#
# DECISION DEL COLEGIO, 8 de septiembre de 2026: se queda en "advertir" y NO se
# pasa nunca a "exigir".
#
# El motivo: hay exalumnos que estuvieron mas de 8 anios en el colegio pero no
# se graduaron aqui, asi que no figuran como egresados en ninguna base. Tienen
# que poder comprar igual. Con "exigir" quedarian por fuera de su propio
# Homecoming por no aparecer en una lista.
#
# Con "advertir" nadie se bloquea. El dato de la promocion lo pone cada quien
# en el formulario, que para el reporte del comite es mas util que una
# validacion que dejaria gente afuera.
#
# La base de mercadeo YA NO ES BLOQUEANTE. Si algun dia llega, sirve para saber
# quien esta verificado, no para negar la entrada:
#   npm run importar-egresados -- egresados.csv
VALIDAR_EGRESADO=advertir

# -----------------------------------------------------------------------------
# Enlaces legales (los muestra el front junto a las casillas obligatorias)
# -----------------------------------------------------------------------------
# Politica de tratamiento de datos. La entrego el colegio el 9 de septiembre de
# 2026: es su documento oficial PL-RC-01, y el archivo vive en el front, en
# public/documentos/. La ruta va RELATIVA a proposito: asi funciona igual en
# local y en produccion sin tener que cambiarla al desplegar.
POLITICA_DATOS_URL=/documentos/PL-RC-01-politica-tratamiento-de-datos.pdf
# VACIO A PROPOSITO. El colegio decidio el 9 de septiembre de 2026 que no habra
# un documento de terminos y condiciones aparte: el unico documento legal es la
# politica de datos de arriba.
#
# No hay nada que arreglar: con esto vacio, el checkout muestra "Acepto los
# terminos y condiciones de la venta" como texto plano en vez de enlace, y la
# casilla sigue siendo obligatoria. Si algun dia aparece el documento, se pega
# la ruta aqui y el enlace aparece solo.
TERMINOS_URL=

# -----------------------------------------------------------------------------
# Wompi
# -----------------------------------------------------------------------------
# Las llaves salen del panel de comercios. La public key es la unica que puede
# viajar al navegador; las otras NUNCA salen del servidor.
#
# Sandbox:     pub_test_  test_integrity_  test_events_
# Produccion:  pub_prod_  prod_integrity_  prod_events_
#
# Las llaves y la WOMPI_API_URL tienen que ser del MISMO ambiente, y NODE_ENV
# acorde. El arranque se niega a correr si se mezclan.
#
# Antes de abrir la venta:  npm run revisar-produccion
WOMPI_PUBLIC_KEY=pub_test_SIN_CONFIGURAR
WOMPI_INTEGRITY_SECRET=integrity_SIN_CONFIGURAR
WOMPI_EVENTS_SECRET=events_SIN_CONFIGURAR

# URL de la API, para CONSULTAR transacciones (la reconciliacion).
#   Sandbox    https://sandbox.wompi.co/v1
#   Produccion https://production.wompi.co/v1
# La consulta de estado se hace con la llave PUBLICA, no con la privada.
WOMPI_API_URL=https://sandbox.wompi.co/v1

# La llave privada NO la necesita este backend: solo sirve para crear y anular
# transacciones, y aqui nunca hacemos ninguna de las dos. Se deja documentada
# para que nadie la pegue "por si acaso": una llave que no esta no se filtra.
WOMPI_PRIVATE_KEY=

# Pagina del FRONT a la que Wompi devuelve al usuario despues de pagar.
WOMPI_REDIRECT_URL=https://homecomingtcs.columbus.edu.co/pago/resultado

# true = pagos de mentira y POST /api/simulacion/pagar habilitado.
# En false, el servidor exige todas las llaves y se niega a arrancar sin ellas.
WOMPI_SIMULACION=true

# AMEX y DINERS no se aceptan (costo financiero alto). Eso NO se configura aqui:
# el Web Checkout muestra los medios habilitados para el comercio, asi que hay
# que pedirle a Wompi que los deshabilite a nivel de cuenta.
# BLOQUEANTE: gestion comercial del colegio con Wompi.

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
# Llave con la que se firman los tokens del QR:  npm run generar-qr-secret
# Cambiarla despues de emitir boletas las invalida TODAS.
QR_SECRET=cambiame-en-produccion-por-favor

# Tokens de acceso. Se mandan como: Authorization: Bearer <token>
ADMIN_TOKEN=admin-cambiame
PUERTA_TOKEN=puerta-cambiame

# -----------------------------------------------------------------------------
# Limites de peticiones (opcionales; estos son los valores por defecto)
# -----------------------------------------------------------------------------
LIMITE_CREAR_ORDEN=10
LIMITE_CONSULTAR_ORDEN=120
LIMITE_REENVIAR=3
LIMITE_ARCHIVOS=60

# -----------------------------------------------------------------------------
# Correo
# -----------------------------------------------------------------------------
# Si SMTP_HOST queda vacio, los correos NO se envian: se guardan como archivos
# .html en datos/correos/ para revisarlos en desarrollo. Con
# WOMPI_SIMULACION=false el servidor exige SMTP_HOST y no arranca sin el.
#
# BLOQUEANTE: el dominio del remitente necesita SPF y DKIM configurados o los
# correos con QR se van a spam. Lo hace TI del colegio.
# La cuenta definitiva la fijo el colegio: homecomingtcs@columbus.edu.co, que
# es tambien el buzon de atencion. Gmail exige que el remitente sea la misma
# cuenta que se autentica, asi que SMTP_USER y MAIL_FROM van iguales.
# La contrasena es una CONTRASENA DE APLICACION de Google (16 letras sin
# espacios), no la de entrar al correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=homecomingtcs@columbus.edu.co
SMTP_PASS=
MAIL_FROM=Homecoming 80 Años <homecomingtcs@columbus.edu.co>

# Canal de atencion al comprador. El colegio decidio NO usar WhatsApp: todas
# las dudas se centralizan en este correo. Sale en el pie de los correos con la
# boleta y en el PDF.
SOPORTE_CORREO=HomecomingTCS@columbus.edu.co

# -----------------------------------------------------------------------------
# SQL Server del colegio (SOLO LECTURA)
# -----------------------------------------------------------------------------
# De aqui sale la configuracion contable con la que SIESA emite la factura. El
# colegio ya le creo a Homecoming su fila en ecampus.dbo.school_services y
# pidio que se lea de ahi, igual que hace su plataforma de eventos.
#
# La venta NO depende de esto: sin configurar, el backend arranca y vende igual.
# Solo la facturacion lo necesita.
#
# La IP es interna: esto solo conecta desde la red del colegio o por VPN.
# Probar con:  npm run probar-siesa
MSSQL_HOST=10.90.11.15
MSSQL_PORT=1433
MSSQL_DB=ecampus
# BLOQUEANTE: pedirle al colegio un usuario de SOLO LECTURA para Homecoming.
# Mientras tanto sirven los del .env de la plataforma:  grep -i mssql FastAPI_TCS/.env
MSSQL_USER=
MSSQL_PASSWORD=
# Id de Homecoming en school_services. Lo creo el colegio.
SIESA_SERVICE_ID=465

# --- Facturacion en SIESA (SOAP contra el ERP) --------------------------------
# Los tres salen del .env de la plataforma de eventos del colegio, que lleva
# meses facturando teatro, carreras y camp con ellos:
#   grep -i siesa /home/eventos/FastAPI_TCS/.env
#
# OJO: http://10.90.11.140:8082 ES PRODUCCION. Lo confirmo el colegio el 10 de
# septiembre de 2026, y en la misma frase aclaro que el 10.90.11.17:8080 que
# aparece en los ejemplos de SOAP YA NO EXISTE.
#
# O sea: NO HAY AMBIENTE DE PRUEBAS. Todo lo que se mande por aqui cae en la
# contabilidad real del colegio, y una factura mal emitida no se borra: se
# anula a mano. Por eso SIESA_ENSAYO de abajo no es una formalidad -- es la
# unica red que hay.
SIESA_WSDL_URL=
SIESA_F_CIA=
# La sucursal que se le CREA a un tercero nuevo, y la que se usa si no tiene
# ninguna. 000 = la persona misma (pedido de contabilidad, 15-sep-2026). A
# quien ya tiene sucursales se le factura a la 000 si la tiene, o a la menor.
SIESA_ID_SUCURSAL=000

# INTERRUPTOR DE SEGURIDAD. En true, el sistema ARMA la factura y la muestra,
# pero NO la manda al ERP.
#
# Como el WSDL de arriba es produccion, la primera vez que esto pase a false
# tiene que ser DE A UNA ORDEN y con contabilidad mirando el ERP:
#   npm run facturar -- HC80-XXXXXX --enviar
# Se revisa esa factura en SIESA, y solo si quedo bien se piensa en lo demas.
SIESA_ENSAYO=true

# A nombre de quien sale la factura.
#
# VACIO (lo normal) = la cedula del comprador, igual que todos los demas
# eventos del colegio. La boleta no es deducible, asi que nadie va a pedir
# factura a su nombre; pero el colegio si reporta el ingreso, y con la cedula
# la venta queda rastreable si alguien reclama.
#
# PLAN B, si contabilidad prefiere no dar de alta a cada comprador: se pone
# aqui el consumidor final y todas las facturas salen contra el. No se pierde
# a quien se le vendio -- nombre, cedula, direccion y ciudad quedan en la
# orden y salen en ordenes.csv. Con un valor aqui, NO se crea ningun tercero.
SIESA_TERCERO_GENERICO=

# Fecha de nacimiento (AAAAMMDD) con la que se crea el tercero de una compra
# que NO la trae. Vacio = la fecha del dia, que es lo que pone el propio SIESA
# al crear un tercero a mano (autorizado por contabilidad el 15-sep-2026).
SIESA_FECHA_NACIMIENTO_DEFECTO=


# --- Alta del comprador como tercero ------------------------------------------
# El comprador tiene que existir en SIESA antes de facturarle. Los demas
# eventos del colegio no se preocupan por esto porque le venden a familias que
# ya estan en el ERP; Homecoming le vende a egresados del 2004 que no estan.
#
# El backend consulta la cedula (SELECT, por el servidor enlazado) y solo si
# no aparece la da de alta como tercero y como cliente/sucursal. A quien ya
# existe NO se le toca nada.

# Codigos DANE con los que se crea el contacto. La ciudad llega como texto
# libre del checkout ("Medellin", "envigado", "MDE") y SIESA la quiere en
# codigo, asi que se usan estos. Son los de los ejemplos que mando el colegio.
SIESA_ID_PAIS=169
SIESA_ID_DEPTO=05
SIESA_ID_CIUDAD=400

# Con que tipo de cliente, vendedor y condicion de pago se da de alta la
# sucursal. VACIO = los mismos de la fila 465 con los que se factura, que es
# lo correcto salvo que contabilidad pida separar a los de Homecoming.
SIESA_ID_TIPO_CLI=
SIESA_ID_VENDEDOR=
SIESA_ID_COND_PAGO=

# Plan de criterios con el que el colegio clasifica a sus clientes. Los
# ejemplos traen "ANE" y "TIC" y ninguno es obviamente el de un egresado
# comprando boleta. VACIO = no se manda el criterio.
SIESA_PLAN_CRITERIOS=
SIESA_CRITERIO_MAYOR=

# Servidor enlazado de SQL Server por donde se ve la base del ERP. Es el mismo
# que usa la plataforma del colegio en sus OPENQUERY.
SIESA_LINKED_SERVER=CSERPDB
